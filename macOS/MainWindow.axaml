<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AKCardScanner.MainWindow"
        Title="AK Card Scanner"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="10,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock x:Name="StatusText" FontSize="12" Text=" " />
    </Border>
    <StackPanel Margin="12" Spacing="12">
      <HeaderedContentControl Header="Cards">
        <Grid ColumnDefinitions="*,100" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
          <ComboBox x:Name="AnimalCombo" Grid.Row="0" HorizontalAlignment="Stretch" PlaceholderText="Animal card" />
          <Button x:Name="AnimalButton" Grid.Row="0" Grid.Column="1" Content="Scan Card" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <ComboBox x:Name="StrongCombo" Grid.Row="1" HorizontalAlignment="Stretch" PlaceholderText="Strong card" />
          <Button x:Name="StrongButton" Grid.Row="1" Grid.Column="1" Content="Scan Card" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <ComboBox x:Name="MiracleCombo" Grid.Row="2" HorizontalAlignment="Stretch" PlaceholderText="Miracle card" />
          <Button x:Name="MiracleButton" Grid.Row="2" Grid.Column="1" Content="Scan Card" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBlock Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                     Text="If you have 3 cards selected you can send them all at once   ▶" />
          <Panel Grid.Row="3" Grid.Column="1">
            <Button x:Name="AllButton" Content="Scan All" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ProgressBar x:Name="Progress" MinWidth="0" Height="8" Minimum="0" Maximum="100" IsVisible="False" VerticalAlignment="Center" />
          </Panel>
        </Grid>
      </HeaderedContentControl>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <HeaderedContentControl Header="Custom Barcode">
          <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
            <TextBox x:Name="CustomBox" Watermark="Enter a custom barcode to send" />
            <Button x:Name="CustomButton" Grid.Column="1" Content="Scan Card" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Grid.Column="1" Header="Server Port">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="PortBox" Width="80" Watermark="Port #" />
            <Button x:Name="TestButton" Content="Test Port" />
          </StackPanel>
        </HeaderedContentControl>
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
